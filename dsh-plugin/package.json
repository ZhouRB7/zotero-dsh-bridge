{
  "name": "@local/zotero-bridge",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "description": "Bridge between DeepSeek Harness and the local Zotero application.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "zotero.js",
    "zotero-dsh.mjs",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
